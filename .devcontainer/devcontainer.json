{
  "name": "Reference Games (Astro)",

  // Node 24 to match the version .github/workflows/deploy.yml builds with.
  //
  // Deliberately no "features": declaring any makes the CLI build a derived
  // image with buildkit before it can start, which is both slower and the
  // step that was crashing on Codespaces hosts. With a plain image and no
  // features the container is just `docker run` on a prebuilt image.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",

  // `astro dev` and `astro preview` both serve on 4321.
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro dev server",
      "onAutoForward": "openPreview"
    }
  },

  // Installs deps, wires up the commit hook, and adds `gh` + the GitHub
  // Copilot CLI so agents (and the client) can work with PRs/issues from the
  // terminal. Pulled into a script because installing `gh` needs its apt repo
  // added first — see post-create.sh for the details and source links.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        // Prettier is the only Markdown formatter here, on purpose. Markdown All
        // in One used to be installed alongside it and reformatted tables and
        // renumbered lists on its own schedule, which is the likeliest source of
        // the mangled HTML blocks in content/. Two formatters, one file type, is
        // how content gets rewritten by something nobody asked.
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "files.eol": "\n",
        // Copilot only reads AGENTS.md when this is on, and it is not on by
        // default in every VS Code build. Without it the agent loses every
        // instruction in AGENTS.md silently, with no warning in chat.
        "chat.useAgentsMdFile": true,
        "[astro]": {
          "editor.defaultFormatter": "astro-build.astro-vscode"
        },
        "editor.formatOnSave": true,
        // Prettier owns Markdown wrapping (see prettier.config.mjs), but it runs
        // at commit time via .githooks/pre-commit — deliberately NOT on save, so
        // the editor never reflows a paragraph out from under someone who is
        // still typing in it. Setting the formatter anyway makes an explicit
        // "Format Document" do the right thing, and stops VS Code guessing.
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": false
        },
        "search.exclude": {
          "**/dist": true,
          "**/.astro": true
        }
      }
    }
  },

  "remoteUser": "node"
}
