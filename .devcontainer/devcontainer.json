{
  "name": "Reference Games (Astro)",

  // Node 24 to match the version .github/workflows/deploy.yml builds with.
  //
  // Deliberately no "features": declaring any makes the CLI build a derived
  // image with buildkit before it can start, which is both slower and the
  // step that was crashing on Codespaces hosts. With a plain image and no
  // features the container is just `docker run` on a prebuilt image.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",

  // `astro dev` and `astro preview` both serve on 4321.
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro dev server",
      "onAutoForward": "openPreview"
    }
  },

  "postCreateCommand": "npm ci",

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "yzhang.markdown-all-in-one",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "files.eol": "\n",
        // Copilot only reads AGENTS.md when this is on, and it is not on by
        // default in every VS Code build. Without it the agent loses every
        // instruction in AGENTS.md silently, with no warning in chat.
        "chat.useAgentsMdFile": true,
        "[astro]": {
          "editor.defaultFormatter": "astro-build.astro-vscode"
        },
        "editor.formatOnSave": true,
        // Games and notes are hand-wrapped prose — leave their line breaks alone.
        "[markdown]": {
          "editor.formatOnSave": false
        },
        "search.exclude": {
          "**/dist": true,
          "**/.astro": true
        }
      }
    }
  },

  "remoteUser": "node"
}
