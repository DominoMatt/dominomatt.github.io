---
import type { Download } from '../lib/content';
import { descriptionLines } from '../lib/content';
import { url } from '../lib/links';

interface Props {
  accent: string;
  downloads: Download[];
  attributions?: string[]; // omit for content with nothing to credit, e.g. notes
}

const { accent, downloads, attributions = [] } = Astro.props;
---

{
  downloads.length > 0 && (
    <section class="footer-block downloads-section" style={`--accent:${accent}`} aria-label="Downloads">
      <div class="label label--h4">DOWNLOADS</div>
      <div class="downloads-list">
        {downloads.map((d) => (
          <div class="dl-row">
            <span class="dl-type">{d.type}</span>
            <div class="dl-body">
              <div class="dl-name">{d.title}</div>
              {descriptionLines(d.description).map((line) => (
                <p class="dl-desc">{line}</p>
              ))}
              <div class="dl-meta">
                <span class="dl-version">{d.version}</span>
                {d.spec && <span class="dl-spec">{d.spec}</span>}
                {d.history.length > 0 && (
                  <details class="dl-history">
                    <summary>
                      <span class="dl-history-marker">
                        <span class="dl-history-closed">▾</span>
                        <span class="dl-history-open">▴</span>
                      </span>{' '}
                      <span class="dl-history-link">
                        <span class="dl-history-closed">
                          {d.history.length} EARLIER VERSION{d.history.length === 1 ? '' : 'S'}
                        </span>
                        <span class="dl-history-open">HIDE VERSIONS</span>
                      </span>
                    </summary>
                  </details>
                )}
              </div>
              {d.history.length > 0 && (
                <div class="dl-history-body">
                  <div class="dl-history-label">VERSION HISTORY</div>
                  {d.history.map((h) => (
                    <div class="dl-history-row">
                      <span class="dl-history-version">{h.version}</span>
                      <span class="dl-history-note">{h.note}</span>
                      <span class="dl-history-date">{h.date}</span>
                      {h.file ? (
                        <a class="dl-history-get" href={url(`/print/${h.file}`)} download>
                          GET →
                        </a>
                      ) : (
                        <span class="dl-history-get" aria-hidden="true" />
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
            <a class="btn btn--solid dl-get" href={url(`/print/${d.file}`)} download>
              GET →
            </a>
          </div>
        ))}
      </div>
    </section>
  )
}

{
  attributions.length > 0 && (
    <section class="footer-block attributions-section" style={`--accent:${accent}`} aria-label="Attributions">
      <div class="label label--h4">ATTRIBUTIONS</div>
      <div class="prose attributions-body" style={`--accent:${accent}`}>
        <ul>
          {attributions.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </div>
    </section>
  )
}
