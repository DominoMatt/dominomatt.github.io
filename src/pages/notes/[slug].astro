---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GameCoverGrid from '../../components/GameCoverGrid.astro';
import NoteReferenceList from '../../components/NoteReferenceList.astro';
import DownloadsList from '../../components/DownloadsList.astro';
import { getNotes, getGames, getReferencedGames, getRelatedNotes, nextPublished } from '../../lib/content';
import type { Note, Game } from '../../lib/content';
import { url } from '../../lib/links';

export async function getStaticPaths() {
  const notes = await getNotes();
  const games = await getGames();
  return notes.map((n, i) => ({
    params: { slug: n.id },
    props: {
      n,
      next: nextPublished(notes, i),
      referencedGames: getReferencedGames(n, games),
      relatedNotes: getRelatedNotes(n, notes),
    },
  }));
}

interface Props {
  n: Note;
  next: Note;
  referencedGames: Game[];
  relatedNotes: Note[];
}

const { n, next, referencedGames, relatedNotes } = Astro.props;
const { Content } = await render(n.entry);
const hasAddendum = n.downloads.length > 0 || relatedNotes.length > 0 || referencedGames.length > 0;
---

<Base title={n.title} description={n.dek}>
  <Breadcrumb section="notes" eyebrow="NOTE" />

  <header class="titleblock titleblock--content titleblock--note">
    <div class="kicker-meta">{n.dateFull}</div>
    <h1 class="page-title">{n.title}</h1>
    <div class="accent-bar" style={`background:${n.accent}`}></div>
    <p class="lede">{n.dek}</p>
  </header>

  <div class="prose" style={`--accent:${n.accent}`}>
    <Content />
  </div>

  {
    hasAddendum && (
      <>
        <hr class="rule rule--addendum rule--heavy" style={`margin-top:52px;background:${n.accent}`} />

        <DownloadsList accent={n.accent} downloads={n.downloads} />

        <NoteReferenceList notes={relatedNotes} label="NOTE REFERENCES" accent={n.accent} />

        <GameCoverGrid games={referencedGames} label="GAME REFERENCES" accent={n.accent} />

        <hr class="rule rule--addendum rule--heavy" style={`margin-top:24px;background:${n.accent}`} />
      </>
    )
  }

  <div class={hasAddendum ? 'footer-actions footer-actions--flush' : 'footer-actions'}>
    <a class="note-next" href={url(`/notes/${next.id}`)}>NEXT · {next.title} →</a>
  </div>

  <p class="copyright-notice">© {n.date.getUTCFullYear()} dominomatt. All rights reserved.</p>
</Base>
