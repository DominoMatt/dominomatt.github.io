---
import '../styles/global.css';
import { site } from '../data/site';
import { url } from '../lib/links';

// Self-hosted, subsetted (latin-only) weights of every face actually used
// across the site — see global.css's --serif-display/--serif-text/--sans/
// --mono. Self-hosting (vs. the old fonts.googleapis.com <link>) drops the
// third-party DNS/TLS round trip before the font request can even start.
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-700.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '@fontsource/libre-franklin/latin-300.css';
import '@fontsource/libre-franklin/latin-400.css';
import '@fontsource/libre-franklin/latin-500.css';
import '@fontsource/libre-franklin/latin-600.css';
import '@fontsource/libre-franklin/latin-400-italic.css';
import '@fontsource/spline-sans-mono/latin-400.css';
import '@fontsource/spline-sans-mono/latin-500.css';

// Preloaded so these three start downloading immediately instead of only
// after the CSS is parsed — every page's very first paint (SiteHeader's
// brand mark + nav, or Breadcrumb's equivalent) uses --serif-display and
// --mono, and --serif-text is the <body> default under nearly all prose.
import caslonDisplayWoff2 from '@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url';
import caslonTextWoff2 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import splineMonoWoff2 from '@fontsource/spline-sans-mono/files/spline-sans-mono-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : site.title;

// Astro.site is the configured origin (astro.config.mjs); Astro.url.pathname
// is already base-aware, so this is correct across all three hosting shapes
// documented in astro.config.mjs without touching src/lib/links.ts.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(url('/og-image.png'), Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32x32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={url('/favicon-16x16.png')} sizes="16x16" type="image/png" />
    <link rel="shortcut icon" href={url('/favicon.ico')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <meta name="theme-color" content="#16140d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preload" as="font" type="font/woff2" href={caslonDisplayWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={caslonTextWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={splineMonoWoff2} crossorigin />
  </head>
  <body>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>
